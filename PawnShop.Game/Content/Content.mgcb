# Fonts use MonoGame's standard content pipeline. Existing PNGs stay direct-loaded.
/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/profile:Reach
/compress:False

#begin Fonts/PixelifySans-Bold.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/PixelifySans-Bold.spritefont

#begin Fonts/Silkscreen-Regular.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/Silkscreen-Regular.spritefont

#begin Fonts/AtkinsonHyperlegible-Regular.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/AtkinsonHyperlegible-Regular.spritefont

#begin Fonts/AtkinsonHyperlegible-Bold.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:Fonts/AtkinsonHyperlegible-Bold.spritefont
