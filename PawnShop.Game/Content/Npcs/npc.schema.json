{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "sprite",
    "interactionBounds"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texture",
        "metadata",
        "idleAnimation"
      ],
      "properties": {
        "texture": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "string",
          "minLength": 1
        },
        "idleAnimation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interactionBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -256,
          "maximum": 256
        },
        "y": {
          "type": "integer",
          "minimum": -256,
          "maximum": 256
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "conversations": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
