{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "spawns"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "npcId",
          "x",
          "y"
        ],
        "properties": {
          "npcId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 80,
            "maximum": 560
          },
          "y": {
            "type": "integer",
            "minimum": 170,
            "maximum": 270
          }
        }
      }
    }
  }
}
