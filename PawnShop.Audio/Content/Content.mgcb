# Audio sources and their build definitions are owned by PawnShop.Audio.
/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/profile:Reach
/compress:False

#begin Music/Forgotten_Treasures.wav
/importer:WavImporter
/processor:SongProcessor
/processorParam:Quality=Best
/build:Music/Forgotten_Treasures.wav

#begin UI/switch_on.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:Quality=Best
/build:UI/switch_on.wav

