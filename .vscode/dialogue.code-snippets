  "Dialogue branch": {
    "prefix": "inkbranch",
    "body": ["=== ${1:answer} ===", "${2:Write the reply here.} # line: ${3:visitor}.${1:answer} # speaker: ${3:visitor}", "-> ${4:END}"],
    "description": "Named branch with one reply and a destination."
  }
}
